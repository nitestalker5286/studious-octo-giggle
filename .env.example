# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-strong-password

# Local default: instance/salvage_tracker.db
# Railway volume recommendation: /data/salvage_tracker.db
DATABASE_PATH=/data/salvage_tracker.db

# Optional full-inventory CSV snapshot after every change.
# This is a server-side file; it does not sync directly to a local Google Drive folder.
# AUTO_EXPORT_PATH=/data/star_citizen_salvage_inventory.csv
